#!/usr/bin/env bash
# git-protect-main pre-push hook (installed by skills/git-protect-main/scripts/install.sh)
# Refuses any push that creates, updates or deletes a protected branch on a remote:
# `git push origin main`, `HEAD:main`, `+main`, `:main`, `--all`, `--mirror`, `git -C <dir> push`.
# Protected branches: `git config guardrails.protected` (space or comma separated), default "main".
# Changes reach a protected branch through a pull request. A human may bypass on purpose
# with `git push --no-verify`.
set -u
set -f

protected=$(git config --get guardrails.protected || true)
protected=${protected:-main}
protected=${protected//,/ }

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${remote_ref:-}" ] || continue
  for branch in $protected; do
    if [ "$remote_ref" = "refs/heads/$branch" ]; then
      echo "pre-push: direct push to '$branch' on '${1:-remote}' refused; push a branch and open a pull request." >&2
      status=1
    fi
  done
done

exit "$status"
